{
  "name": "meal-planner",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "db:create": "createdb meal_planner",
    "db:drop": "dropdb meal_planner",
    "db:migrate": "node-pg-migrate up --migration-file-language sql -m migrations",
    "db:rollback": "node-pg-migrate down --migration-file-language sql -m migrations",
    "db:setup": "npm run db:create && npm run db:migrate",
    "db:reset": "npm run db:drop && npm run db:setup",
    "db:seed": "psql -d meal_planner -v household_id=$HOUSEHOLD_ID -f scripts/seed-data.sql",
    "dev": "ts-node src/server.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "start": "node dist/server.js",
    "test": "DATABASE_URL=postgresql://localhost/meal_planner_test vitest run",
    "test:watch": "DATABASE_URL=postgresql://localhost/meal_planner_test vitest",
    "test:unit": "vitest run services/__tests__ utils/__tests__ __tests__",
    "db:test:setup": "createdb meal_planner_test && DATABASE_URL=postgresql://localhost/meal_planner_test node-pg-migrate up --migration-file-language sql -m migrations"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.7"
  }
}
